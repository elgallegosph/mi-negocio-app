rules_version = '2';
// Reglas de seguridad: solo las personas con cuenta (creadas por ti en Firebase > Authentication)
// pueden leer y escribir. Nadie más puede ver los datos del negocio.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
